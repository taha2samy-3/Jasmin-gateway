{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "pruneStaleBranches": true,
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "always",
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Block immediate creation/acceptance of major updates: require manual Dependency Dashboard approval and disable automerge",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Enable auto-merge for GitHub Actions patch and minor updates via PR if CI passes",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Allow updates for npm dependencies",
      "matchManagers": ["npm"],
      "enabled": true
    },
    {
      "description": "Allow updates for Helm chart dependencies and image tags",
      "matchManagers": ["helm-values", "helmv3"],
      "enabled": true
    },
    {
      "description": "Allow minor and patch updates for Dockerfiles",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": true
    }
  ]
}
